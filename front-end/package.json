{
  "devDependencies": {
    "concat-cli": "^4.0.0",
    "javascript-obfuscator": "^4.1.1",
    "terser": "^5.39.0"
  },
  "scripts": {
    "build:js": "terser ./js/*.js -o ./js/min/ --compress --mangle",
    "obfuscate": "javascript-obfuscator ./js/pedidos.js --output ./js/obfuscated --compact true --control-flow-flattening true",
    "build:all": "npm run combine && npm run obfuscate"
  }
}
